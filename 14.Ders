void zamYap(List<Map<String, dynamic>> zamlanacakUrunler, double yuzdeOran) {
  for (var urun in zamlanacakUrunler) {
    urun["fiyat"] += urun["fiyat"] * yuzdeOran;
  }
}


List<Map<String,dynamic>> uzerindekiUrunler(List<Map<String,dynamic>> urunler, int limit){
  List<Map<String, dynamic>> uzerinde = [];

  for (var urun in urunler) {
    if (urun["fiyat"] > limit) {
      uzerinde.add(urun);
    }
  }
  
  return uzerinde;
}

