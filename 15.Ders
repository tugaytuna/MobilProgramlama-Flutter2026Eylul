void goster(String isim) {
  if (isim == "Tugay") {
    print("Admin hoş geldin!");
  } else {
    print("$isim hoş geldiniz!");
  }
}

double kdvEkle(int sayi){
  double toplam = sayi * 1.2;
  return toplam;
}

bool adminMi(List<String> adminListesi,String kullanici){
  for(String admin in adminListesi){
    if(kullanici == admin){
      return true;
    }
  }
  
  return false;
}



